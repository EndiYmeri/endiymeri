---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Endi Ymeri — Full Stack Developer',
  description = 'Welcome to the portfolio of Endi Ymeri — full stack developer crafting clear products and quiet motion.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={"Full Stack Developer crafting clear products and quiet motion."} />
    <title>{title}</title>
    <link
      rel="preload"
      href="/fonts/Syne-VariableFont_wght.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Figtree-VariableFont_wght.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
  </head>
  <body>
    <slot />
  </body>
</html>
